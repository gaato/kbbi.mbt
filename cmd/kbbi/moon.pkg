import {
  "gaato/kbbi" @lib,
  "gaato/mttp/backend",
  "gaato/mttp/runtime",
  "gaato/mttp_core/client",
  "moonbitlang/core/async",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
}

import {
  "gaato/mttp_core",
} for "wbtest"

supported_targets = "wasm + native"

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
