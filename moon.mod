name = "gaato/kbbi"

version = "0.1.6"

readme = "README.md"

repository = "https://github.com/gaato/kbbi.mbt"

license = "Apache-2.0"

keywords = [ "kbbi", "indonesian", "dictionary", "cli", "skill", "agent" ]

description = "Unofficial KBBI (Kamus Besar Bahasa Indonesia) lookup for MoonBit: a library, a CLI, and an agent skill."

preferred_target = "wasm"

import {
  "bobzhang/html_parser@0.2.0",
  "gaato/http@0.5.0",
  "gaato/http-async@0.5.0",
  "moonbitlang/async@0.22.5",
  "moonbitlang/x@0.5.6",
}
