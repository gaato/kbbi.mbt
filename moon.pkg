import {
  "bobzhang/html_parser",
  "bobzhang/html_parser/dom",
  "gaato/http",
  "gaato/mttp/client",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}

supported_targets = "wasm + native + js"

import {
  "gaato/http/driver",
  "gaato/http/sim",
} for "wbtest"

options(
  "allow-experimental-packages": [ "gaato/http/driver" ],
)
