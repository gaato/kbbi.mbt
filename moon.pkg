import {
  "bobzhang/html_parser",
  "bobzhang/html_parser/dom",
  "gaato/mttp_core",
  "gaato/mttp_core/client",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}

supported_targets = "wasm + native + js"

import {
  "gaato/mttp_core/driver",
  "gaato/mttp_core/sim",
} for "wbtest"

options(
  "allow-experimental-packages": [ "gaato/mttp_core/driver" ],
)
